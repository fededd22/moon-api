# انسخ هذا الملف إلى .env ثم عدّل القيم
MOON_MASTER_SECRET=      # python -c "import secrets;print(secrets.token_hex(32))"  (لا تفقده!)
ADMIN_API_KEY=           # نفس الطريقة
PUBLIC_API_URL=https://api.your-domain.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=123456789      # معرّفات مفصولة بفاصلة
TELEGRAM_PUBLIC_MODE=false          # true = يسمح لأي شخص برفع ملفاته

API_KEY_TTL=86400
RATE_LIMIT=100
MAX_EXECUTION_TIME=20
MAX_MEMORY_MB=512
MAX_CONCURRENT_RUNS=4
MAX_PROJECTS_PER_USER=10
